        {
          "name": "SETUP - All Products List (optional, store-wide)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response time is acceptable (<3000ms)', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Response has products array', function () {",
                  "    pm.expect(jsonData).to.have.property('products');",
                  "    pm.expect(jsonData.products).to.be.an('array');",
                  "});",
                  "pm.test('Default page size is 30 or fewer products', function () {",
                  "    pm.expect(jsonData.products.length).to.be.at.most(30);",
                  "});",
                  "pm.test('Each product has id, handle, and variants', function () {",
                  "    jsonData.products.forEach(function(p) {",
                  "        pm.expect(p).to.have.property('id');",
                  "        pm.expect(p).to.have.property('handle');",
                  "        pm.expect(p).to.have.property('variants');",
                  "    });",
                  "});",
                  "// Note: this isn't scoped to a collection like API_003 — it lists products store-wide.",
                  "// Shopify caps this at 30 per page by default; try adding ?limit=250&page=2 to check pagination.",
                  "// Also good for grabbing a fresh, real product handle/variant id if the one in the env ever goes stale."
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{itokri_base_url}}/products.json",
              "host": [
